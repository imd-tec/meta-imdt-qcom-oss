From bcbf8c769f55d1fc883a4fcb2ac783a657497bd0 Mon Sep 17 00:00:00 2001
From: William Bright <william.bright@imd-tec.com>
Date: Mon, 31 Aug 2026 18:18:23 +0100
Subject: [PATCH] Revert "PENDING: media: iris: enable sm8550 context banks via
 init_cb_devs"

This reverts commit 29dd374b66de864b7ee5bf4425a4309da94bfaef in
qualcomm-linux/kernel, which is still present in the SRCREV meta-qcom
pins (8d5dbc1b17ad, tag qcom-next-7.2-rc3-20260731).

sm8550_init_cb_devs() configures its context bank devices with
of_dma_configure_id(), which needs an "iommu-map" property on the
video-codec node. sm8550.dtsi has plain "iommus", so no IOMMU attaches,
the device falls back to direct DMA and dma_set_mask(0xdfffffff) fails
against the 32-bit minimum mask. Probe then aborts:

  qcom-iris aa00000.video-codec: probe with driver qcom-iris failed with error -5

and the VPU never comes up: no /dev/video encoder or decoder node, and
the firmware is never loaded.

Upstream dropped this approach in b7f7360dbc0a ("Revert "PENDING: media:
iris: add context bank devices using iommu-map"") and replaced it with a
device tree child node lookup that returns NULL harmlessly when the node
is absent, in f8c980b909f2 ("FROMLIST: media: iris: Add helper to create
a context bank device"):

  https://lore.kernel.org/all/20260715-glymur-v9-3-8cf2cbe12a07@oss.qualcomm.com/

Only glymur.dtsi defines the pixel/non-pixel children, so on sm8550 the
context banks are skipped entirely either way. Without the hooks
iris_get_cb_dev() falls back to the core device, iris probes and the
H.264 encoder works.

Drop this patch once meta-qcom's kernel SRCREV moves past those upstream
reverts. Note qcom-next rebases, so those hashes are not stable.

Upstream-Status: Inappropriate [reverts a downstream qcom-next patch]
Signed-off-by: William Bright <william.bright@imd-tec.com>
---
 .../platform/qcom/iris/iris_platform_vpu3x.c  | 43 -------------------
 1 file changed, 43 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c b/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
index ffa5aa018c1b..8763a78381c2 100644
--- a/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
+++ b/drivers/media/platform/qcom/iris/iris_platform_vpu3x.c
@@ -104,47 +104,6 @@ static const struct tz_cp_config tz_cp_config_vpu3[] = {
 	},
 };
 
-static int sm8550_init_cb_devs(struct iris_core *core)
-{
-	const u32 f_id_np = 0; /* IRIS_NON_PIXEL_VCODEC */
-	const u32 f_id_p = 1;  /* IRIS_PIXEL */
-	struct device *dev;
-
-	dev = iris_create_cb_dev(core, "iris_non_pixel", &f_id_np);
-	if (IS_ERR(dev))
-		return PTR_ERR(dev);
-
-	core->dev_np = dev;
-	core->dev_bs = core->dev_np;
-
-	dev = iris_create_cb_dev(core, "iris_pixel", &f_id_p);
-	if (IS_ERR(dev))
-		goto err_unreg_dev_np;
-
-	core->dev_p = dev;
-
-	return 0;
-
-err_unreg_dev_np:
-	platform_device_unregister(to_platform_device(core->dev_np));
-	core->dev_np = NULL;
-	core->dev_bs = NULL;
-
-	return PTR_ERR(dev);
-}
-
-static void sm8550_deinit_cb_devs(struct iris_core *core)
-{
-	if (core->dev_np)
-		platform_device_unregister(to_platform_device(core->dev_np));
-	if (core->dev_p)
-		platform_device_unregister(to_platform_device(core->dev_p));
-
-	core->dev_np = NULL;
-	core->dev_bs = NULL;
-	core->dev_p = NULL;
-}
-
 /*
  * Shares most of SM8550 data except:
  * - inst_caps to platform_inst_cap_qcs8300
@@ -182,8 +141,6 @@ const struct iris_platform_data qcs8300_data = {
 const struct iris_platform_data sm8550_data = {
 	.firmware_desc_gen2 = &iris_vpu30_p4_gen2_desc,
 	.vpu_ops = &iris_vpu3_ops,
-	.init_cb_devs = sm8550_init_cb_devs,
-	.deinit_cb_devs = sm8550_deinit_cb_devs,
 	.icc_tbl = iris_icc_info_vpu3x,
 	.icc_tbl_size = ARRAY_SIZE(iris_icc_info_vpu3x),
 	.clk_rst_tbl = sm8550_clk_reset_table,
-- 
2.43.0

