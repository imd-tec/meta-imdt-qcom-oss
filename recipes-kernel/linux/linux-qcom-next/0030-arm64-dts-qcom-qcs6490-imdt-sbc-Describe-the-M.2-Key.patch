From 08b43137aa4e5a27d8bdf3d55787380d3c31946d Mon Sep 17 00:00:00 2001
From: William Bright <william.bright@imd-tec.com>
Date: Fri, 23 Oct 2026 09:52:59 +0100
Subject: [PATCH] arm64: dts: qcom: qcs6490-imdt-sbc: Describe the M.2 Key-E
 connector

Describe J46 with the pcie-m2-e-connector binding, linked to the PCIe0
root port and to USB1. The connector owns the VM2E_3V3 rail,
W_DISABLE1# and W_DISABLE2# (GPIO 84 and 85, through a non-inverting
NXS0104) and SDIO_RESET# (GPIO 153), so pcie0 no longer holds the SDIO
reset.

Tested on SoM 01 with a WCN7850 card: Wi-Fi on ath12k and BT on btusb.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: William Bright <william.bright@imd-tec.com>
---
 arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc.dts | 86 ++++++++++++++++---
 1 file changed, 73 insertions(+), 13 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc.dts b/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc.dts
index df5ca90a188d..3f6b0ae84021 100644
--- a/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc.dts
+++ b/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc.dts
@@ -63,6 +63,47 @@ chosen {
 		stdout-path = "serial0:115200n8";
 	};
 
+	/* J46, M.2 Key-E */
+	m2e_connector: connector-m2-e {
+		compatible = "pcie-m2-e-connector";
+		vpcie3v3-supply = <&vreg_m2e_3p3>;
+
+		/* W_DISABLE#s go through the NXS0104 (U513), non-inverting */
+		w-disable1-gpios = <&tlmm 84 GPIO_ACTIVE_LOW>;
+		w-disable2-gpios = <&tlmm 85 GPIO_ACTIVE_LOW>;
+		sdio-reset-gpios = <&tlmm 153 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&m2e_w_disable_default>, <&m2e_sdio_resetn_default>;
+		pinctrl-names = "default";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				m2e_pcie_ep: endpoint@0 {
+					reg = <0>;
+					remote-endpoint = <&pcie0_port_ep>;
+				};
+			};
+
+			port@2 {
+				reg = <2>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				m2e_usb_ep: endpoint@0 {
+					reg = <0>;
+					remote-endpoint = <&usb_2_m2e_ep>;
+				};
+			};
+		};
+	};
+
 	/*
 	 * 2-pin fan header J44, switched on/off by FAN_CONTROL (GPIO_133)
 	 * through a MOSFET. The nominal RPM is indicative only; there is
@@ -227,6 +268,16 @@ m2_pd_pwr: regulator-m2-pd-pwr {
 		gpio-open-drain;
 	};
 
+	/* U6 output to J46, enabled by m2_pd_pwr */
+	vreg_m2e_3p3: regulator-m2e-3p3 {
+		compatible = "regulator-fixed";
+		regulator-name = "VM2E_3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		vin-supply = <&m2_pd_pwr>;
+	};
+
 	per_1v8_reg: regulator-per-1v8 {
 		compatible = "regulator-fixed";
 		regulator-name = "per_1v8_reg";
@@ -564,20 +615,22 @@ &pcie0 {
 	perst-gpios = <&tlmm 87 GPIO_ACTIVE_LOW>;
 	wake-gpios = <&tlmm 89 GPIO_ACTIVE_HIGH>;
 
-	/*
-	 * pcie0 hosts the M.2 Key-E slot. Apply the SDIO reset de-assert
-	 * here so any module's chip enable is settled before pcie0 trains
-	 * its link.
-	 */
 	pinctrl-0 = <&pcie0_clkreq_n>,
 		    <&pcie0_reset_n>,
-		    <&pcie0_wake_n>,
-		    <&m2e_sdio_resetn_default>;
+		    <&pcie0_wake_n>;
 	pinctrl-names = "default";
 
 	status = "okay";
 };
 
+&pcie0_port {
+	port {
+		pcie0_port_ep: endpoint {
+			remote-endpoint = <&m2e_pcie_ep>;
+		};
+	};
+};
+
 &pcie0_phy {
 	vdda-phy-supply = <&vreg_l10c_0p88>;
 	vdda-pll-supply = <&vreg_l6b_1p2>;
@@ -774,17 +827,18 @@ m2_pd_en_default: m2-pd-en-default-state {
 		drive-open-drain;
 	};
 
-	/*
-	 * We drive this GPIO physically high on the M.2 Key-E connector
-	 * to make sure the module is enabled. An M.2 Key-E module could
-	 * be using this pin as a chip enable.
-	 */
+	m2e_w_disable_default: m2e-w-disable-default-state {
+		pins = "gpio84", "gpio85";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	m2e_sdio_resetn_default: m2e-sdio-resetn-default-state {
 		pins = "gpio153";
 		function = "gpio";
 		drive-strength = <2>;
 		bias-disable;
-		output-high;
 	};
 
 	panel_en_default: panel-en-default-state {
@@ -944,6 +998,12 @@ &usb_2 {
 	dr_mode = "host";
 
 	status = "okay";
+
+	port {
+		usb_2_m2e_ep: endpoint {
+			remote-endpoint = <&m2e_usb_ep>;
+		};
+	};
 };
 
 &usb_2_hsphy {
