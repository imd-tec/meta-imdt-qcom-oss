diff --git a/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-ar1335-csi0.dtso b/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-ar1335-csi0.dtso
new file mode 100644
index 000000000000..2728ce45357e
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-ar1335-csi0.dtso
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * QCS6490 IMDT SBC AR1335 carrier CSI0 (J40) camera overlay (SoM 01)
+ *
+ * Copyright (c) 2026 IMD Technologies Ltd
+ */
+
+#include <dt-bindings/clock/qcom,camcc-sc7280.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/dts-v1/;
+/plugin/;
+
+&tlmm {
+	ar1335_csi0_mclk_default: ar1335-csi0-mclk-default-state {
+		pins = "gpio65";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	ar1335_csi0_rst_default: ar1335-csi0-rst-default-state {
+		pins = "gpio21";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
+
+&camss {
+	vdda-phy-supply = <&vreg_l10c_0p88>;
+	vdda-pll-supply = <&vreg_l6b_1p2>;
+
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* Carrier CSI0 is QCS6490 CSIPHY3 on SoM 01 */
+		port@3 {
+			reg = <3>;
+
+			csiphy3_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&ar1335_csi0_ep>;
+			};
+		};
+	};
+};
+
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	ar1335_csi0: sensor@36 {
+		compatible = "onnn,ar1335";
+		reg = <0x36>;
+
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		clock-names = "extclk";
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 21 GPIO_ACTIVE_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&ar1335_csi0_mclk_default &ar1335_csi0_rst_default>;
+
+		vdd_io-supply = <&cam_1v8_reg>;
+		vdd-supply = <&cam_1v2_reg>;
+		vaa-supply = <&hr_cam_pwr>;
+
+		orientation = <0>;	/* Front */
+		rotation = <0>;
+
+		port {
+			ar1335_csi0_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				remote-endpoint = <&csiphy3_ep>;
+			};
+		};
+	};
+};
