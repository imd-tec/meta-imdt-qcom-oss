new file mode 100644
index 000000000000..b30e8296da31
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc-ar1335-csi4.dtso
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * QCS8550 IMDT SBC AR1335 CSI4 camera overlay
+ *
+ * CSI4 to CSI7 share the always-on camera I2C bus (CCI1 bus 1), split by a
+ * TCA9546 switch at 0x74. CSI4 is on switch channel 0.
+ *
+ * Copyright (c) 2026 IMD Technologies Ltd
+ */
+
+#include <dt-bindings/clock/qcom,sm8550-camcc.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/dts-v1/;
+/plugin/;
+
+&tlmm {
+	cci1_aon_csi4_default: cci1-aon-csi4-default-state {
+		sda-pins {
+			pins = "gpio208";
+			function = "aon_cci";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		scl-pins {
+			pins = "gpio209";
+			function = "aon_cci";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	ar1335_csi4_rst_default: ar1335-csi4-rst-default {
+		mux {
+			pins = "gpio120";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio120";
+			drive-strength = <16>;
+			bias-disable;
+		};
+	};
+};
+
+&camss {
+	status = "okay";
+
+	vdda-phy-supply = <&vreg_l1e_0p88>;
+	vdda-pll-supply = <&vreg_l3e_1p2>;
+
+	ports {
+		port@4 {
+			csiphy4_ep: endpoint {
+				clock-lanes = <4>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&ar1335_csi4_ep>;
+			};
+		};
+	};
+};
+
+&cci1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+	pinctrl-0 = <&cci1_0_default &cci1_aon_csi4_default>;
+
+	i2c-bus@1 {
+		reg = <1>;
+		clock-frequency = <100000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		i2c-mux@74 {
+			compatible = "nxp,pca9546";
+			reg = <0x74>;
+			vdd-supply = <&cam_1v8_reg>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			i2c@0 {
+				reg = <0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				ar1335_csi4: sensor@36 {
+					compatible = "onnn,ar1335";
+					reg = <0x36>;
+
+					clocks = <&camcc CAM_CC_MCLK4_CLK>;
+					clock-names = "extclk";
+					assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
+					assigned-clock-rates = <19200000>;
+
+					reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;
+
+					pinctrl-names = "default";
+					pinctrl-0 = <&cam4_default &ar1335_csi4_rst_default>;
+
+					vdd_io-supply = <&cam_1v8_reg>;
+					vdd-supply = <&cam_1v2_reg>;
+					vaa-supply = <&hr_cam_pwr>;
+
+					orientation = <0>;	/* Front */
+					rotation = <0>;
+
+					port {
+						ar1335_csi4_ep: endpoint {
+							data-lanes = <1 2 3 4>;
+							remote-endpoint = <&csiphy4_ep>;
+						};
+					};
+				};
+			};
+		};
+	};
+};
