From 6c9120d7343fe320488084dd0e7d9ed88ebd91aa Mon Sep 17 00:00:00 2001
From: William Bright <william.bright@imd-tec.com>
Date: Wed, 21 Oct 2026 15:00:59 +0100
Subject: [PATCH] arm64: dts: qcom: qcs8550-imdt-sbc: Drive SM_RESOUT_N_1P8
 high

The carrier's SM_RESOUT_N_1P8 is GPIO 92, not the SoM reset output. It
enables the buffer that drives the DSI backlight enable and lights the
reset LED, so hog it high.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: William Bright <william.bright@imd-tec.com>
---
 arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc.dts b/arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc.dts
index f4d4d0bb8823..cd72438c14a1 100644
--- a/arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc.dts
+++ b/arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc.dts
@@ -748,6 +748,14 @@ data3-pins {
 		};
 	};
 
+	/* Carrier SM_RESOUT_N_1P8: enables the backlight buffer and reset LED */
+	sm-resout-n-hog {
+		gpio-hog;
+		gpios = <92 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "sm-resout-n";
+	};
+
 	wcd_default: wcd-reset-n-active-state {
 		pins = "gpio108";
 		function = "gpio";
