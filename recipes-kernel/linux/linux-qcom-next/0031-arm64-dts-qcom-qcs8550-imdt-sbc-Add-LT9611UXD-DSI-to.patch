From 4aaff4b2d8d8cad1488584e712dd085b28a2d8a1 Mon Sep 17 00:00:00 2001
From: William Bright <william.bright@imd-tec.com>
Date: Mon, 9 Nov 2026 13:09:14 +0000
Subject: [PATCH] arm64: dts: qcom: qcs8550-imdt-sbc: Add LT9611UXD DSI to HDMI
 overlay

Add an overlay for the Lontium LT9611UXD adapter (IM-PCA-0055-01) on
the display connector J41. The bridge sits at 0x49 on i2c4, with reset
on GPIO 133 and the interrupt on GPIO 88. The adapter 5V comes from the
existing dsi_5v_en regulator.

The bridge firmware only decodes video when both MIPI ports are fed,
so run DSI0 and DSI1 as a dual DSI pair into ports A and B, with DSI1
clocked from the DSI0 PLL. The driver drives reset to 1 and then 0, so
the reset GPIO is active low.

Use it instead of the display overlay. The interrupt polarity through
the carrier is not confirmed.

Signed-off-by: William Bright <william.bright@imd-tec.com>
---
 arch/arm64/boot/dts/qcom/Makefile             |   1 +
 .../qcom/qcs8550-imdt-sbc-dsi-lt9611uxd.dtso  | 144 ++++++++++++++++++
 2 files changed, 145 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc-dsi-lt9611uxd.dtso

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index b4f1dd054862..d795b27ef448 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -278,6 +278,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-aim300-aiot.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-rb5gen2.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-display.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-dsi-lt9611uxd.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-ar1335-csi0.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-pcie-keyb.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-cypd6125.dtbo
diff --git a/arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc-dsi-lt9611uxd.dtso b/arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc-dsi-lt9611uxd.dtso
new file mode 100644
index 000000000000..b68892197339
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc-dsi-lt9611uxd.dtso
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) 2026 IMD Technologies Ltd
+ *
+ * Lontium LT9611UXD DSI to HDMI adapter (IM-PCA-0055-01) on the display
+ * connector J41. Use instead of the qcs8550-imdt-sbc-display overlay.
+ * The bridge firmware needs both MIPI ports, so DSI0 and DSI1 run as a
+ * dual DSI pair.
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/clock/qcom,dsi-phy-28nm.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+&{/} {
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&lt9611_out>;
+			};
+		};
+	};
+};
+
+&tlmm {
+	lt9611_reset_default: lt9611-reset-default-state {
+		pins = "gpio133";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	lt9611_int_default: lt9611-int-default-state {
+		pins = "gpio88";
+		function = "gpio";
+		bias-disable;
+	};
+};
+
+/* J41 pins 40/44, the same bus as the touch controller */
+&i2c4 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <100000>;
+	status = "okay";
+
+	hdmi-bridge@49 {
+		compatible = "lontium,lt9611uxd";
+		reg = <0x49>;
+
+		interrupts-extended = <&tlmm 88 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&lt9611_reset_default>, <&lt9611_int_default>;
+		pinctrl-names = "default";
+
+		/* The adapter derives its 3V3 and 1V2 rails from +DSI_5V */
+		vcc-supply = <&dsi_5v_en>;
+		vdd-supply = <&dsi_5v_en>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				lt9611_a: endpoint {
+					remote-endpoint = <&mdss_dsi0_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				lt9611_b: endpoint {
+					remote-endpoint = <&mdss_dsi1_out>;
+				};
+			};
+
+			port@2 {
+				reg = <2>;
+
+				lt9611_out: endpoint {
+					remote-endpoint = <&hdmi_con_in>;
+				};
+			};
+		};
+	};
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l3e_1p2>;
+	qcom,dual-dsi-mode;
+	qcom,master-dsi;
+	status = "okay";
+};
+
+&mdss_dp0 {
+	status = "disabled";
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&lt9611_a>;
+	data-lanes = <0 1 2 3>;
+	status = "okay";
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l1e_0p88>;
+	status = "okay";
+};
+
+&mdss_dsi1 {
+	vdda-supply = <&vreg_l3e_1p2>;
+	qcom,dual-dsi-mode;
+
+	/* DSI1 is the slave, so it runs from the DSI0 PLL */
+	assigned-clock-parents = <&mdss_dsi0_phy DSI_BYTE_PLL_CLK>,
+				 <&mdss_dsi0_phy DSI_PIXEL_PLL_CLK>;
+
+	status = "okay";
+};
+
+&mdss_dsi1_out {
+	remote-endpoint = <&lt9611_b>;
+	data-lanes = <0 1 2 3>;
+	status = "okay";
+};
+
+&mdss_dsi1_phy {
+	vdds-supply = <&vreg_l1e_0p88>;
+	status = "okay";
+};
-- 
