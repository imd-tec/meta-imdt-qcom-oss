From 9311b513539cedad9a810509ab453fc0aa073dbd Mon Sep 17 00:00:00 2001
From: William Bright <william.bright@imd-tec.com>
Date: Wed, 21 Oct 2026 15:10:11 +0100
Subject: [PATCH] arm64: dts: qcom: qcs6490-imdt-sbc: Add display overlay

Add an overlay for the TST070WSBE-196C DSI panel on the J41 display
connector. PM7325 GPIO6 has no LPG, so the backlight is a simple on/off
GPIO. gpio-backlight can't take a supply, so keep DSI_5V on for the LED
boost. The panel runs in video mode, so TE is left unconnected, which
also keeps it off the SoM 02 BT UART on GPIO 60.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: William Bright <william.bright@imd-tec.com>
---
 arch/arm64/boot/dts/qcom/Makefile             |  1 +
 .../dts/qcom/qcs6490-imdt-sbc-display.dtso    | 96 +++++++++++++++++++
 2 files changed, 97 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-display.dtso

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index f5a543522acd..5da8cbb9effb 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -236,6 +236,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-ar1335-csi0.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-ar1335-csi1.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-ar1335-csi2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-ar1335-csi3.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-display.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-pcie-keyb.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-radxa-dragon-q6a.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-rb3gen2.dtb
diff --git a/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-display.dtso b/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-display.dtso
new file mode 100644
index 000000000000..aa5ff5bf1221
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-display.dtso
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) 2026 IMD Technologies Ltd
+ *
+ * TST070WSBE-196C DSI panel on the J41 display connector (DSI0)
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+
+&{/} {
+	/* PM7325 GPIO6 has no LPG, so the backlight is on/off only */
+	backlight: backlight {
+		compatible = "gpio-backlight";
+		gpios = <&pm7325_gpios 6 GPIO_ACTIVE_HIGH>;
+		default-on;
+
+		pinctrl-0 = <&bl_en_default>;
+		pinctrl-names = "default";
+	};
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	vdda-supply = <&vreg_l6b_1p2>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "team-source-display,tst070wsbe-196c";
+		reg = <0>;
+
+		/* DISP0_RST_N is wired as the panel enable */
+		enable-gpios = <&tlmm 44 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&panel_reset_default>;
+		pinctrl-names = "default";
+
+		power-supply = <&display_panel_pwr_en>;
+		backlight = <&backlight>;
+
+		port {
+			panel0_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel0_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi_phy {
+	vdds-supply = <&vreg_l10c_0p88>;
+	status = "okay";
+};
+
+/* DSI_5V feeds the LED boost, gpio-backlight can't enable it */
+&dsi_5v_en {
+	regulator-boot-on;
+	regulator-always-on;
+};
+
+&display_panel_pwr_en {
+	/* Let the panel rails settle before releasing reset */
+	startup-delay-us = <30000>;
+};
+
+&pm7325_gpios {
+	bl_en_default: bl-en-default-state {
+		pins = "gpio6";
+		function = "normal";
+		bias-disable;
+		output-low;
+		power-source = <1>;
+	};
+};
+
+&tlmm {
+	/* Open-drain like the 8550, so panel-simple's enable gets a rising edge */
+	panel_reset_default: panel-reset-default-state {
+		pins = "gpio44";
+		function = "gpio";
+		drive-strength = <2>;
+		drive-open-drain;
+		bias-pull-up;
+	};
+};
