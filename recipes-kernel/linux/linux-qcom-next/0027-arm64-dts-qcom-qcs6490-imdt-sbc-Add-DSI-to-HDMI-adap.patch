From a805710e202a0b4328d39e6c013e200b3f1da5d4 Mon Sep 17 00:00:00 2001
From: William Bright <william.bright@imd-tec.com>
Date: Thu, 22 Oct 2026 08:55:43 +0100
Subject: [PATCH] arm64: dts: qcom: qcs6490-imdt-sbc: Add DSI to HDMI adapter
 overlay

Add an overlay for the ST B-LCDAD-HDMI1 DSI to HDMI adapter (ADV7533)
on the J41 display connector: the bridge on i2c13 (J41 pins 40/44) fed
by DSI0 with four lanes, and an HDMI type D connector. J41 pin 57 drives
the ADV7533 PD pin, which pulls itself up and holds the bridge in power
down, so hand it to the driver as pd-gpios. The interrupt is J41 pin 4.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: William Bright <william.bright@imd-tec.com>
---
 arch/arm64/boot/dts/qcom/Makefile             |   1 +
 .../dts/qcom/qcs6490-imdt-sbc-dsi-hdmi.dtso   | 116 ++++++++++++++++++
 2 files changed, 117 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-dsi-hdmi.dtso

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 5da8cbb9effb..b4f1dd054862 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -237,6 +237,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-ar1335-csi1.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-ar1335-csi2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-ar1335-csi3.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-display.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-dsi-hdmi.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-pcie-keyb.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-radxa-dragon-q6a.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-rb3gen2.dtb
diff --git a/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-dsi-hdmi.dtso b/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-dsi-hdmi.dtso
new file mode 100644
index 000000000000..f467ba4df662
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-dsi-hdmi.dtso
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) 2026 IMD Technologies Ltd
+ *
+ * ADV7533 DSI to HDMI adapter on the J41 display connector (DSI0)
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+&{/} {
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "d";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&adv7533_out>;
+			};
+		};
+	};
+};
+
+/* J41 pins 40/44, the display connector I2C */
+&i2c13 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <100000>;
+	status = "okay";
+
+	hdmi-bridge@39 {
+		compatible = "adi,adv7533";
+		reg = <0x39>;
+
+		/* J41 pin 4 INT, pulled up on the adapter */
+		interrupts-extended = <&tlmm 24 IRQ_TYPE_LEVEL_LOW>;
+
+		/* J41 pin 57 drives the ADV7533 PD pin, which pulls itself up */
+		pd-gpios = <&tlmm 44 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&adv7533_int_default>, <&adv7533_pd_default>;
+		pinctrl-names = "default";
+
+		adi,dsi-lanes = <4>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				adv7533_in: endpoint {
+					remote-endpoint = <&mdss_dsi0_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				adv7533_out: endpoint {
+					remote-endpoint = <&hdmi_con_in>;
+				};
+			};
+		};
+	};
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi {
+	vdda-supply = <&vreg_l6b_1p2>;
+	status = "okay";
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&adv7533_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi_phy {
+	vdds-supply = <&vreg_l10c_0p88>;
+	status = "okay";
+};
+
+/* The adapter runs from the J41 DSI_5V and panel power rails */
+&dsi_5v_en {
+	regulator-boot-on;
+	regulator-always-on;
+};
+
+&display_panel_pwr_en {
+	regulator-boot-on;
+	regulator-always-on;
+};
+
+&tlmm {
+	adv7533_int_default: adv7533-int-default-state {
+		pins = "gpio24";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	adv7533_pd_default: adv7533-pd-default-state {
+		pins = "gpio44";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
