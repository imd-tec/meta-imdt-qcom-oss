From 605460670fd8407226470127a933a465b55aa89e Mon Sep 17 00:00:00 2001
From: William Bright <william.bright@imd-tec.com>
Date: Wed, 14 Oct 2026 14:23:15 +0100
Subject: [PATCH] arm64: dts: qcom: qcs8550-imdt-sbc: Add AR1335 overlays for
 CSI1 to CSI3

Add overlays for AR1335 modules on CSI1, CSI2 and CSI3, alongside the
existing CSI0 one. The CCI buses, MCLKs and reset GPIOs follow the IMDT
CamX device tree for the board:

  CSI1  CCI2 bus 0  MCLK1  GPIO117
  CSI2  CCI0 bus 1  MCLK2  GPIO118
  CSI3  CCI1 bus 0  MCLK3  GPIO119

Each overlay uses its own labels so that they can be applied together.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: William Bright <william.bright@imd-tec.com>
---
 arch/arm64/boot/dts/qcom/Makefile             |  3 +
 .../qcom/qcs8550-imdt-sbc-ar1335-csi1.dtso    | 83 +++++++++++++++++++
 .../qcom/qcs8550-imdt-sbc-ar1335-csi2.dtso    | 83 +++++++++++++++++++
 .../qcom/qcs8550-imdt-sbc-ar1335-csi3.dtso    | 83 +++++++++++++++++++
 4 files changed, 252 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc-ar1335-csi1.dtso
 create mode 100644 arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc-ar1335-csi2.dtso
 create mode 100644 arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc-ar1335-csi3.dtso

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -282,6 +282,9 @@ dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-display.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-dsi-lt9611uxd.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-ar1335-csi0.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-ar1335-csi1.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-ar1335-csi2.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-ar1335-csi3.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-pcie-keyb.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs8550-imdt-sbc-cypd6125.dtbo
 
diff --git a/arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc-ar1335-csi1.dtso b/arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc-ar1335-csi1.dtso
new file mode 100644
index 000000000000..8beea0a1aa2c
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/qcs8550-imdt-sbc-ar1335-csi1.dtso
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * QCS8550 IMDT SBC AR1335 CSI1 camera overlay
+ *
+ * Copyright (c) 2026 IMD Technologies Ltd
+ */
+
+#include <dt-bindings/clock/qcom,sm8550-camcc.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/dts-v1/;
+/plugin/;
+
+&tlmm {
+	ar1335_csi1_rst_default: ar1335-csi1-rst-default {
+		mux {
+			pins = "gpio117";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio117";
+			drive-strength = <16>;
+			bias-disable;
+		};
+	};
+};
+
+&camss {
+	status = "okay";
+
+	vdda-phy-supply = <&vreg_l1e_0p88>;
+	vdda-pll-supply = <&vreg_l3e_1p2>;
+
+	ports {
+		port@1 {
+			csiphy1_ep: endpoint {
+				clock-lanes = <4>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&ar1335_csi1_ep>;
+			};
+		};
+	};
+};
+
+&cci2 {
+	status = "okay";
+};
+
+&cci2_i2c0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	clock-frequency = <100000>;
+	ar1335_csi1: sensor@36 {
+		compatible = "onnn,ar1335";
+		reg = <0x36>;
+
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		clock-names = "extclk";
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 117 GPIO_ACTIVE_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam1_default &ar1335_csi1_rst_default>;
+
+		vdd_io-supply = <&cam_1v8_reg>;
+		vdd-supply = <&cam_1v2_reg>;
+		vaa-supply = <&hr_cam_pwr>;
+
+		orientation = <0>;	/* Front */
+		rotation = <0>;
+
+		port {
+			ar1335_csi1_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				remote-endpoint = <&csiphy1_ep>;
+			};
+		};
+	};
+};
