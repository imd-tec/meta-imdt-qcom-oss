+	int fw_mode;
 
 	err = ccg_read(uc, CCGX_RAB_DEVICE_MODE, (u8 *)(&uc->info),
 		       sizeof(uc->info));
@@ -1123,29 +1284,38 @@ static int ccg_fw_update_needed(struct ucsi_ccg *uc,
 	err = ccg_read(uc, CCGX_RAB_READ_ALL_VER, (u8 *)version,
 		       sizeof(version));
