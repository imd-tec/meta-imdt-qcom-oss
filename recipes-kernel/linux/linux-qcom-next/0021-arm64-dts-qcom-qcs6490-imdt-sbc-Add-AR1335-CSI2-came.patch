From f2147111552c00d63425b2f6b3f73f2ff1e03a3c Mon Sep 17 00:00:00 2001
From: William Bright <william.bright@imd-tec.com>
Date: Tue, 20 Oct 2026 14:26:44 +0100
Subject: [PATCH] arm64: dts: qcom: qcs6490-imdt-sbc: Add AR1335 CSI2 camera
 overlay

Describe the AR1335 on the carrier CSI2 connector (J35) of the SoM 01
board. The sensor sits on CCI1 bus 0 with MCLK3 on GPIO 67 and its
reset on GPIO 78, and SoM 01 routes carrier CSI2 to CSIPHY1.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: William Bright <william.bright@imd-tec.com>
---
 arch/arm64/boot/dts/qcom/Makefile             |  1 +
 .../qcom/qcs6490-imdt-sbc-ar1335-csi2.dtso    | 89 +++++++++++++++++++
 2 files changed, 90 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-ar1335-csi2.dtso

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 9ef35a976570..122d3549a46e 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -232,6 +232,7 @@ qcs615-ride-el2-dtbs := qcs615-ride.dtb talos-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs615-ride-el2.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= talos-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-ar1335-csi2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-imdt-sbc-pcie-keyb.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-radxa-dragon-q6a.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= qcs6490-rb3gen2.dtb
diff --git a/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-ar1335-csi2.dtso b/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-ar1335-csi2.dtso
new file mode 100644
index 000000000000..fbd50b14be5d
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/qcs6490-imdt-sbc-ar1335-csi2.dtso
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * QCS6490 IMDT SBC AR1335 carrier CSI2 (J35) camera overlay (SoM 01)
+ *
+ * Copyright (c) 2026 IMD Technologies Ltd
+ */
+
+#include <dt-bindings/clock/qcom,camcc-sc7280.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/dts-v1/;
+/plugin/;
+
+&tlmm {
+	ar1335_csi2_mclk_default: ar1335-csi2-mclk-default-state {
+		pins = "gpio67";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	ar1335_csi2_rst_default: ar1335-csi2-rst-default-state {
+		pins = "gpio78";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
+
+&camss {
+	vdda-phy-supply = <&vreg_l10c_0p88>;
+	vdda-pll-supply = <&vreg_l6b_1p2>;
+
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* Carrier CSI2 is QCS6490 CSIPHY1 on SoM 01 */
+		port@1 {
+			reg = <1>;
+
+			csiphy1_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&ar1335_csi2_ep>;
+			};
+		};
+	};
+};
+
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	ar1335_csi2: sensor@36 {
+		compatible = "onnn,ar1335";
+		reg = <0x36>;
+
+		clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		clock-names = "extclk";
+		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 78 GPIO_ACTIVE_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&ar1335_csi2_mclk_default &ar1335_csi2_rst_default>;
+
+		vdd_io-supply = <&cam_1v8_reg>;
+		vdd-supply = <&cam_1v2_reg>;
+		vaa-supply = <&hr_cam_pwr>;
+
+		orientation = <0>;	/* Front */
+		rotation = <0>;
+
+		port {
+			ar1335_csi2_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				remote-endpoint = <&csiphy1_ep>;
+			};
+		};
+	};
+};
