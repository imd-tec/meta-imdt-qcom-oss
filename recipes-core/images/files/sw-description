/*
 * SWUpdate manifest for the IMDT QCS8550 SBC base image.
 *
 * The single image entry uses the custom 'rootfs_ab' handler, shipped on
 * the target by swupdate-imdt-handlers as swupdate_handlers.lua and
 * loaded at SWUpdate startup (CONFIG_HANDLER_IN_LUA — handlers cannot be
 * registered from an embedded-script in sw-description). The handler
 * picks the *inactive* slot from the device /proc/mounts shows mounted as
 * / (3 -> /dev/sda3 active, 4 -> /dev/sda4 active; the U-Boot
 * 'rootfs_part' env var is only cross-checked, since it can desync and
 * acting on a stale value would raw-write the live rootfs), delegates the
 * actual write to the built-in 'raw' handler, then flips 'rootfs_part'
 * (and resets bootcount / sets upgrade_available) on success. The result:
 * a single .swu can be installed via the web UI, the IPC socket or the CLI
 * without any -e selection or wrapper, and always lands on the inactive
 * slot.
 *
 * hardware-compatibility is matched against /etc/hwrevision on the
 * target (shipped via base-files: 'imdt-8550-sbc 1.0').
 */
software =
{
    version = "@@SWUPDATE_VERSION@@";
    description = "@@SWUPDATE_IMAGE@@ A/B rootfs update";

    hardware-compatibility: [ "1.0" ];

    images = (
        {
            /* The file copied into the .swu cpio is the basename of the
             * source artifact in DEPLOY_DIR_IMAGE — i.e. it carries the
             * machine + .rootfs infix that modern Yocto attaches. */
            filename   = "@@SWUPDATE_IMAGE@@-@@MACHINE@@.rootfs.ext4.gz";
            type       = "rootfs_ab";
            compressed = "zlib";
        }
    );
};
