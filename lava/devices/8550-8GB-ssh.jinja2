{# Device dictionary for the 8550-8GB-ssh LAVA device (device-type: ssh) —
   the 8 GB IMDT 8550 SBC attached to pi-tester-2.

   ssh_host is the LAN IP of the Pi that forwards the DUT's sshd on port
   2222 (adb forward + relay, set up by the lava-forwarding service).
   It must NOT be 'localhost': the ssh client runs inside the
   lava-dispatcher container on the compose bridge network, where
   localhost is the container itself.

   The identity file is the private key matching
   recipes-core/lava-ssh-keys/files/lava-dut-key.pub, installed into the
   dispatcher's worker-state volume:

     docker compose cp lava-dut-key lava-dispatcher:/var/lib/lava/dispatcher/worker/lava-dut-key

   Install on the server with:

     lava-server manage devices add 8550-8GB-ssh --device-type ssh --worker worker0 --tags dut-ssh 8550-8gb
     # then place this file at
     # /etc/lava-server/dispatcher-config/devices/8550-8GB-ssh.jinja2 (owner lavaserver)
#}
{% extends 'ssh.jinja2' %}
{% set ssh_host = 'PI-TESTER-2-LAN-IP' %}
{% set ssh_port = 2222 %}
{% set ssh_user = 'root' %}
{% set ssh_identity_file = '/var/lib/lava/dispatcher/worker/lava-dut-key' %}
