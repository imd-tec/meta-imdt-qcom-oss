[Unit]
Description=Configure the AR1335 camera media pipeline
# The camss media device is created by the kernel once the AR1335
# overlay is applied; skip silently if no camera/overlay is present.
ConditionPathExists=/dev/media0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/qcs6490-ar1335.sh

[Install]
WantedBy=multi-user.target
